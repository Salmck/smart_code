# 复制为 ordinex.env 后填入真实值；此文件权限建议 chmod 600（内含密钥）
# cp deploy/ordinex.env.example deploy/ordinex.env && chmod 600 deploy/ordinex.env

# 生产模式：关闭验证码控制台回显；结构升级走非破坏式迁移，不清库
DEBUG=false

# 对外访问地址：二维码内容会指向这里，必须是公网 https 域名
PUBLIC_BASE_URL=https://wujexu.com

# 登录态签名密钥 —— 必须替换！生成：openssl rand -hex 32
JWT_SECRET=在这里粘贴_openssl_rand_hex_32_的输出

# 动态核销码签名密钥 —— 必须替换！生成：openssl rand -hex 32
DYNCODE_SECRET=在这里粘贴另一个_openssl_rand_hex_32_的输出

# 数据库与上传目录（默认相对路径，配合 WorkingDirectory；也可写绝对路径）
# DATABASE_URL=sqlite:////opt/ordinex/ordinex.db
# UPLOAD_DIR=/opt/ordinex/data/uploads
